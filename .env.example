# .env.example
# === База данных ===
DATABASE_URL=postgresql+psycopg2://newsuser:newspass@db:5432/newsdb

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === JWT ===
SECRET_KEY=super-secret-jwt-key-change-in-production-please-1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # неделя

# === MinIO / S3 ===
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=news-images
S3_PUBLIC_URL=http://localhost:9000/news-images

# === Дополнительно (необязательно) ===
# Если хочешь другой порт для FastAPI
# APP_HOST=0.0.0.0
# APP_PORT=8000